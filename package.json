{
  "name": "react-paginate",
  "version": "8.3.0",
  "description": "A ReactJS component that creates a pagination.",
  "main": "./dist/react-paginate.umd.js",
  "module": "./dist/react-paginate.es.js",
  "exports": {
    ".": {
      "import": "./dist/react-paginate.es.js",
      "require": "./dist/react-paginate.cjs.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AdeleD/react-paginate"
  },
  "keywords": [
    "react-component",
    "paginate",
    "paginator",
    "pagination"
  ],
  "author": {
    "name": "Adèle Delamarche"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AdeleD/react-paginate/issues"
  },
  "dependencies": {
    "prop-types": "^15"
  },
  "peerDependencies": {
    "react": "^16 || ^17 || ^18 || ^19"
  },
  "devDependencies": {
    "@testing-library/react": "^13",
    "@vitejs/plugin-react": "^4",
    "core-js": "^3",
    "eslint": "^7",
    "eslint-plugin-react": "^7",
    "husky": "^8",
    "jsdom": "^24",
    "prettier": "^2.7",
    "react": "^18",
    "react-dom": "^18",
    "styled-components": "^5",
    "vite": "^5",
    "vitest": "^1"
  },
  "scripts": {
    "test": "vitest",
    "test:watch": "vitest --watch",
    "build": "vite build",
    "demo": "vite --config demo/vite.config.js",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint"
    }
  }
}
